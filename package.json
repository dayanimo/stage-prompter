{
  "name": "stage-prompter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline live-performance lyrics & chords prompter",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
