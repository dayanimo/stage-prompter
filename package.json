{
  "name": "stage-prompter",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Offline live-performance lyrics & chords prompter",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/qrcode": "^1.5.6",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.60.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.1.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.2",
    "idb": "^8.0.1",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.55"
  }
}
